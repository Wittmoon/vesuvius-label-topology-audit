+    m, _ = lta.audit(v)
+    assert m["n_components"] == 6 and m["n_tiny"] == 5
+    assert m["n_big_components"] == 1 and m["b1_total_big"] == 0
+
+
+def test_ignore_voxels_are_not_foreground_and_mark_components_open():
+    v = sheet()
