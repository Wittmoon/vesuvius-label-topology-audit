+
+def test_interior_component_is_closed():
+    v = np.zeros((40, 40, 40), np.uint8)
+    v[18:20, 10:30, 10:30] = 1
+    m, _ = lta.audit(v)
+    assert m["n_closed_big"] == 1
+
