+    ct = sheet_volume()
+    a = np.array([[[30.0, 24, 24], [30.0, 24, 25], [30.0, 25, 24], [30.0, 25, 25]]] * 3).reshape(3, 4, 3)
+    n = np.zeros_like(a)
+    n[..., 0] = 1
+    ok = np.ones((3, 4), bool)
+    split = a.copy()
+    split[..., 0] = np.array([26, 26, 34, 34])
+    steady = a.copy()
+    steady[..., 0] = 31
+    e = [{"rank": 1}]
+    placement_edits.candidate_scores(a, {"split": (split, ok, n), "steady": (steady, ok, n)}, e, {1: ok},
